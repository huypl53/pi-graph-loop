# goal-max-nudges: Exercises setting and updating goal maxNudges, including -1 (infinite).
# Proves swarm_set_goal accepts maxNudges (-1 or positive integer), preserves it on update,
# and supports marking the goal done cleanly.
{"name":"set goal with infinite max nudges","events":[{"type":"text","delayMs":15,"text":"Setting a swarm goal with maxNudges: -1 (infinite idle nudges until marked done).","chunks":["Setting a swarm goal ","with maxNudges: -1 ","(infinite idle nudges until marked done)."]},{"type":"toolcall","delayMs":15,"name":"swarm_set_goal","id":"set-max-nudges-1","arguments":{"text":"Implement feature with infinite nudges","maxNudges":-1}}]}
{"name":"update goal max nudges to 5","events":[{"type":"text","delayMs":15,"text":"Updating maxNudges to 5 on the active goal.","chunks":["Updating maxNudges to 5 ","on the active goal."]},{"type":"toolcall","delayMs":15,"name":"swarm_set_goal","id":"update-max-nudges-2","arguments":{"update":true,"maxNudges":5}}]}
{"name":"update goal max nudges back to infinite","events":[{"type":"text","delayMs":15,"text":"Updating maxNudges back to -1 (infinite) on the active goal.","chunks":["Updating maxNudges back to -1 ","(infinite) on the active goal."]},{"type":"toolcall","delayMs":15,"name":"swarm_set_goal","id":"update-max-nudges-3","arguments":{"update":true,"maxNudges":-1}}]}
{"name":"mark goal done","events":[{"type":"text","delayMs":10,"text":"Goal work is complete. Marking the goal done stops the infinite nudge loop.","chunks":["Goal work is complete. ","Marking the goal done ","stops the infinite nudge loop."]},{"type":"toolcall","delayMs":10,"name":"swarm_mark_goal_done","id":"done-max-nudges-4","arguments":{}}]}
{"name":"goal-max-nudges final stop","stopReason":"stop","events":[{"type":"text","delayMs":5,"text":"All goal maxNudges operations completed."},{"type":"stop","delayMs":5,"reason":"stop"}]}
