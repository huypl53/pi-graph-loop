# root-delegation-guard: exercises root performing consecutive edits, receiving the advisory notice, and delegating to swarm workers
{"name": "root edit 1", "events": [{"type": "toolcall", "delayMs": 10, "name": "edit", "id": "edit-1", "arguments": {"path": "src/a.ts"}}, {"type": "stop", "delayMs": 5, "reason": "toolUse"}]}
{"name": "root edit 2", "events": [{"type": "toolcall", "delayMs": 10, "name": "edit", "id": "edit-2", "arguments": {"path": "src/b.ts"}}, {"type": "stop", "delayMs": 5, "reason": "toolUse"}]}
{"name": "root edit 3 triggers advisory", "events": [{"type": "toolcall", "delayMs": 10, "name": "edit", "id": "edit-3", "arguments": {"path": "src/c.ts"}}, {"type": "stop", "delayMs": 5, "reason": "toolUse"}]}
{"name": "root delegates to worker after advisory", "events": [{"type": "toolcall", "delayMs": 10, "name": "swarm_create_task", "id": "swarm-1", "arguments": {"task": "fix code issues", "files": ["src/c.ts"]}}, {"type": "text", "delayMs": 10, "text": "Advisory received. Creating task to delegate further code implementation to swarm workers.", "chunks": ["Advisory received. ", "Creating task to delegate ", "further code implementation to swarm workers."]}, {"type": "stop", "delayMs": 5, "reason": "stop"}]}
