# drift-then-wake: first turn stalls, later turn wakes back up with a normal completion; this is a recovery control sample rather than a stall mode.
{"name":"drift phase","events":[{"type":"text","delayMs":15,"text":"I’m drifting for a bit.","chunks":["I’m drifting ","for a bit."]},{"type":"hang","delayMs":15,"until":"abort"}]}
{"name":"wake phase","stopReason":"stop","events":[{"type":"text","delayMs":15,"text":"Recovered — continuing from the scripted wake-up.","chunks":["Recovered — ","continuing from the scripted wake-up."]},{"type":"stop","delayMs":5,"reason":"stop"}]}
