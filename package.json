{
  "name": "pi-graph-agents",
  "version": "0.1.0",
  "description": "Pi package for the swarm graph/task extension and related validation artifacts.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "swarm",
    "agents",
    "task-graph",
    "qualification-gate",
    "qualification"
  ],
  "pi": {
    "extensions": [
      "./extensions/swarm"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test:swarm": "node scripts/run-suites.mjs --dir extensions/swarm/tests",
    "test:mockllm": "node scripts/run-suites.mjs --dir extensions/mock-llm/tests",
    "test:swarm:one": "PI_SWARM_AGENT_ID=root PI_SWARM_IS_ROOT=1 node",
    "format": "prettier --write \"extensions/**/*.{ts,mjs}\" \"scripts/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,mjs}\" \"scripts/**/*.{ts,mjs}\""
  },
  "files": [
    "extensions/",
    "skills/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE*"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*",
    "typescript": "^5"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
